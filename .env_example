# Server IP address (use 127.0.0.1 for localhost or public IP for remote)
SERVER_IP=127.0.0.1

# Blob Storage Configuration
# S3_ENDPOINT: Internal endpoint for dataserver (defaults to ${SERVER_IP}:9000 if not set)
# S3_PUBLIC_ENDPOINT: External URL for client uploads (with protocol)
S3_PUBLIC_ENDPOINT=http://${SERVER_IP}:9000

## SECRETS
#DB
MYSQLDATABASE=zotprimeprod
MYSQLUSER=zotprimeprod
MYSQLPASSWORD=zotprimeprod

MYSQLROOTPASSWORD=zotero

#MINIO
MINIOROOTUSER=zotero
MINIOROOTPASSWORD=zoterodocker

#API Super User (for admin operations)
# Generate token: openssl rand -hex 32
# Generate hash: php -r "echo password_hash('YOUR_TOKEN_HERE', PASSWORD_BCRYPT);"
# Windows: Use Git Bash or WSL for openssl
API_SUPER_TOKEN=
API_SUPER_TOKEN_HASH=

#Auth Salt (for legacy password hashing)
# Generate: openssl rand -hex 16
AUTH_SALT=

#Initial Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.tld

#Web Admin UI
